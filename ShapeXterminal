local posLabel   = liveSection:CreateLabel("Position: —", Theme.Text)
local jobSection = StatsTab:CreateSection("Session Info")
local jobLabel   = jobSection:CreateLabel("JobId: " .. tostring(game.JobId ~= "" and game.JobId or "Studio/Local"), Theme.Dim)
local plyLabel   = jobSection:CreateLabel("Player: " .. player.Name, Theme.Dim)
local plrCountLabel = jobSection:CreateLabel("Players in server: —", Theme.Dim)

local frameCount, lastFpsUpdate = 0, os.clock()
RunService.RenderStepped:Connect(function()
    frameCount += 1
    local now = os.clock()
    if now - lastFpsUpdate >= 0.5 then
        local fps = math.floor(frameCount / (now - lastFpsUpdate))
        fpsLabel.Text = "FPS: " .. fps
        frameCount, lastFpsUpdate = 0, now
    end
end)

task.spawn(function()
    while true do
        pcall(function()
            pingLabel.Text = "Ping: " .. math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) .. " ms"
        end)
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum then
                hpLabel.Text = "Health: " .. math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
                wsLabel.Text = "WalkSpeed: " .. hum.WalkSpeed
            end
            if hrp then
                local p = hrp.Position
                posLabel.Text = string.format("Position: %.1f, %.1f, %.1f", p.X, p.Y, p.Z)
            end
        end
        plrCountLabel.Text = "Players in server: " .. #Players:GetPlayers()
        task.wait(1)
    end
end)

-- ---------------- TAB 2: SETTINGS ----------------
local SettingsTab = Win:CreateTab("Settings", "⚙")
local uiSection = SettingsTab:CreateSection("UI Preferences")

uiSection:CreateToggle({
    Name = "Enable glitch effect on tab switch",
    CurrentValue = false,
    Callback = function(state)
        print("[ShapeX] Glitch effect:", state)
    end
})

uiSection:CreateSlider({
    Name = "UI Scale",
    Range = {80, 130},
    CurrentValue = 100,
    Callback = function(val)
        local scale = Window:FindFirstChildOfClass("UIScale")
        if not scale then
            scale = Instance.new("UIScale")
            scale.Parent = Window
        end
        scale.Scale = val / 100
    end
})

uiSection:CreateDropdown({
    Name = "Accent Color",
    Options = {"Blue/Purple", "Green", "Red", "Amber"},
    CurrentOption = "Blue/Purple",
    Callback = function(choice)
        local map = {
            ["Blue/Purple"] = Color3.fromRGB(120,130,255),
            ["Green"]       = Color3.fromRGB(90,210,130),
            ["Red"]         = Color3.fromRGB(255,90,90),
            ["Amber"]       = Color3.fromRGB(255,185,60),
        }
        Theme.Accent = map[choice]
    end
})

local behaviorSection = SettingsTab:CreateSection("Behavior")
behaviorSection:CreateToggle({
    Name = "Hide on RightShift",
    CurrentValue = true,
})
behaviorSection:CreateButton({
    Name = "Reset window size & position",
    Callback = function()
        Window.Size = sizePresets[2]
        Window.Position = UDim2.fromScale(0.5, 0.5)
        sizeIndex = 2
    end
})

