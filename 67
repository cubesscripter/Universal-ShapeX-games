-- Patch Tab
local PatchTab = Window:CreateTab("Patch", "wrench")

PatchTab:CreateSection("Anti-Cheat / Patches")

PatchTab:CreateButton({
    Name = "Bypass Anti-Cheat",
    Callback = function()
        local success = pcall(function()
            -- Common anti-cheat bypass patterns
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local oldNamecall = mt.__namecall
            mt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if method == "FireServer" or method == "InvokeServer" then
                    if tostring(self):lower():find("ban") or tostring(self):lower():find("kick") or tostring(self):lower():find("detect") then
                        return nil
                    end
                end
                return oldNamecall(self, ...)
            end)
            setreadonly(mt, true)
        end)
        
        if success then
            Rayfield:Notify({
                Title = "Success",
                Content = "Anti-cheat bypassed!",
                Duration = 2,
                Image = "check"
            })
        else
            Rayfield:Notify({
                Title = "Info",
                Content = "Bypass may already be active",
                Duration = 2,
                Image = "info"
            })
        end
    end
})

PatchTab:CreateButton({
    Name = "Patch Remote Security",
    Callback = function()
        for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
            if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                -- Hook remotes to prevent detection
                local oldFire = remote.FireServer
                remote.FireServer = function(self, ...)
                    local args = {...}
                    -- Filter out detection calls
                    if #args > 0 and type(args[1]) == "table" then
                        if args[1].Detect or args[1].Check then
                            return nil
                        end
                    end
                    return oldFire(self, ...)
                end
            end
        end
        Rayfield:Notify({
            Title = "Success",
            Content = "Remote security patched!",
            Duration = 2,
            Image = "check"
        })
    end
})

