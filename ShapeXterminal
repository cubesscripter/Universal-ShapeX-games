-- ============================================================
-- LIBRARY: Window / Tab / Section / Components
-- ============================================================
local Library = {}
local WindowAPI = {}
WindowAPI.__index = WindowAPI

local tabs = {}       -- list of {button, page, name}
local activeTabIdx = nil

local function setActiveTab(idx)
    for i, t in ipairs(tabs) do
        local isActive = (i == idx)
        t.page.Visible = isActive
        local targetBg = isActive and Theme.Panel or Theme.Sidebar
        local targetText = isActive and Theme.Text or Theme.SubText
        TweenService:Create(t.button, TweenInfo.new(0.15), {BackgroundColor3 = targetBg}):Play()
        t.label.TextColor3 = targetText
        t.indicator.BackgroundTransparency = isActive and 0 or 1
    end
    activeTabIdx = idx
end

function Library.CreateWindow(title)
    if title then TitleText.Text = title end
    return setmetatable({}, WindowAPI)
end

function WindowAPI:CreateTab(name, icon)
    icon = icon or "▸"
    local index = #tabs + 1

    -- Sidebar button
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Theme.Sidebar
    btn.BackgroundTransparency = 0
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.LayoutOrder = index
    btn.Parent = TabList

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 1, -10)
    indicator.Position = UDim2.fromOffset(0, 5)
    indicator.BackgroundColor3 = Theme.Accent
    indicator.BackgroundTransparency = 1
    indicator.BorderSizePixel = 0
    indicator.Parent = btn
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

    local iconLabel = Instance.new("TextLabel")
    iconLabel.BackgroundTransparency = 1
    iconLabel.Size = UDim2.fromOffset(24, 34)
    iconLabel.Position = UDim2.fromOffset(12, 0)
    iconLabel.Font = FONT
    iconLabel.TextSize = 14
    iconLabel.TextColor3 = Theme.SubText
    iconLabel.Text = icon
    iconLabel.Parent = btn

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, -46, 1, 0)
    label.Position = UDim2.fromOffset(38, 0)
    label.Font = FONT
    label.TextSize = TXT_SIZE
    label.TextColor3 = Theme.SubText
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = name
    label.Parent = btn

    btn.MouseEnter:Connect(function()
        if activeTabIdx ~= index then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.Panel}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if activeTabIdx ~= index then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Theme.Sidebar}):Play()
        end
    end)

    -- Page (scrolling content)
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundColor3 = Theme.Panel
    page.BackgroundTransparency = 0
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = Theme.AccentDim
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.CanvasSize = UDim2.new(0,0,0,0)
    page.Visible = false
    page.Parent = ContentArea

    local pagePad = Instance.new("UIPadding")
    pagePad.PaddingTop = UDim.new(0, 16)
    pagePad.PaddingLeft = UDim.new(0, 16)
    pagePad.PaddingRight = UDim.new(0, 16)
    pagePad.PaddingBottom = UDim.new(0, 16)
    pagePad.Parent = page

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Padding = UDim.new(0, 14)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Parent = page

    btn.MouseButton1Click:Connect(function() setActiveTab(index) end)

    tabs[index] = {button = btn, page = page, label = label, indicator = indicator, name = name}
    if index == 1 then setActiveTab(1) end

    -- ===================== Tab API =====================
    local TabAPI = {}
    TabAPI.__index = TabAPI

    function TabAPI:CreateSection(sectionName)
        local sectionOrder = #page:GetChildren()

        local Section = Instance.new("Frame")
        Section.Size = UDim2.new(1, 0, 0, 0)
        Section.AutomaticSize = Enum.AutomaticSize.Y
        Section.BackgroundColor3 = Theme.SectionBg
        Section.BorderSizePixel = 0
        Section.LayoutOrder = sectionOrder
        Section.Parent = page
        Instance.new("UICorner", Section).CornerRadius = UDim.new(0, 6)
        local secStroke = Instance.new("UIStroke", Section)
        secStroke.Color = Theme.Border
        secStroke.Thickness = 1

        local secPad = Instance.new("UIPadding")
        secPad.PaddingTop = UDim.new(0, 10)
        secPad.PaddingBottom = UDim.new(0, 12)
        secPad.PaddingLeft = UDim.new(0, 14)
        secPad.PaddingRight = UDim.new(0, 14)
        secPad.Parent = Section

        local secLayout = Instance.new("UIListLayout")
        secLayout.Padding = UDim.new(0, 8)
        secLayout.SortOrder = Enum.SortOrder.LayoutOrder
        secLayout.Parent = Section

        local Header = Instance.new("TextLabel")
        Header.BackgroundTransparency = 1
        Header.Size = UDim2.new(1, 0, 0, 16)
        Header.Font = FONT_BOLD
        Header.TextSize = 11
        Header.TextColor3 = Theme.Accent
        Header.TextXAlignment = Enum.TextXAlignment.Left
        Header.Text = "◆ " .. sectionName:upper()
        Header.LayoutOrder = 0
        Header.Parent = Section

        local SectionAPI = {}
        SectionAPI.__index = SectionAPI
        local itemOrder = 1

        local function baseRow(height)
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, height)
            row.BackgroundTransparency = 1
            row.LayoutOrder = itemOrder
            itemOrder += 1
            row.Parent = Section
            return row
        end

        function SectionAPI:CreateLabel(text, color)
            local row = baseRow(18)
            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.Font = FONT
            lbl.TextSize = TXT_SIZE
            lbl.TextColor3 = color or Theme.Text
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Text = text
            lbl.Parent = row
            return lbl -- has .Text settable for live updates
        end

        function SectionAPI:CreateButton(config)
            config = config or {}
            local row = baseRow(30)
            local btn2 = Instance.new("TextButton")
            btn2.Size = UDim2.new(1, 0, 1, 0)
            btn2.BackgroundColor3 = Theme.ToggleOff
            btn2.AutoButtonColor = false
            btn2.Font = FONT
            btn2.TextSize = TXT_SIZE
            btn2.TextColor3 = Theme.Text
            btn2.Text = config.Name or "Button"
            btn2.Parent = row
            Instance.new("UICorner", btn2).CornerRadius = UDim.new(0, 4)
            btn2.MouseEnter:Connect(function() TweenService:Create(btn2, TweenInfo.new(0.1), {BackgroundColor3 = Theme.AccentDim}):Play() end)
            btn2.MouseLeave:Connect(function() TweenService:Create(btn2, TweenInfo.new(0.1), {BackgroundColor3 = Theme.ToggleOff}):Play() end)
            btn2.MouseButton1Click:Connect(function()
                if config.Callback then config.Callback() end
            end)
            return btn2
        end

        function SectionAPI:CreateToggle(config)
            config = config or {}
            local state = config.CurrentValue or false
            local row = baseRow(26)

            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Size = UDim2.new(1, -50, 1, 0)
            lbl.Font = FONT
            lbl.TextSize = TXT_SIZE
            lbl.TextColor3 = Theme.Text
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Text = config.Name or "Toggle"
            lbl.Parent = row

            local track = Instance.new("TextButton")
            track.Size = UDim2.fromOffset(40, 20)
            track.Position = UDim2.new(1, -40, 0.5, -10)
            track.BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff
            track.AutoButtonColor = false
            track.Text = ""
            track.Parent = row
            Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.fromOffset(16, 16)
            knob.Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
            knob.Parent = track
            Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

            track.MouseButton1Click:Connect(function()
                state = not state
                TweenService:Create(track, TweenInfo.new(0.15), {BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff}):Play()
                TweenService:Create(knob, TweenInfo.new(0.15), {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}):Play()
                if config.Callback then config.Callback(state) end
            end)
            return {Set = function(_, v) state = v; track.BackgroundColor3 = v and Theme.ToggleOn or Theme.ToggleOff; knob.Position = v and UDim2.new(1,-18,0.5,-8) or UDim2.new(0,2,0.5,-8) end}
        end

        function SectionAPI:CreateSlider(config)
            config = config or {}
            local min, max = config.Range and config.Range[1] or 0, config.Range and config.Range[2] or 100
            local value = config.CurrentValue or min
            local row = baseRow(40)

            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Size = UDim2.new(1, 0, 0, 16)
            lbl.Font = FONT
            lbl.TextSize = TXT_SIZE
            lbl.TextColor3 = Theme.Text
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Text = (config.Name or "Slider") .. ": " .. tostring(value)
            lbl.Parent = row

            local bar = Instance.new("Frame")
            bar.Size = UDim2.new(1, 0, 0, 8)
            bar.Position = UDim2.fromOffset(0, 22)
            bar.BackgroundColor3 = Theme.ToggleOff
            bar.Parent = row
            Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            fill.BackgroundColor3 = Theme.Accent
            fill.Parent = bar
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

            local dragBtn = Instance.new("TextButton")
            dragBtn.BackgroundTransparency = 1
            dragBtn.Size = UDim2.new(1, 0, 1, 0)
            dragBtn.Text = ""
            dragBtn.Parent = bar

            local draggingSlider = false
            local function updateFromX(xPos)
                local rel = math.clamp((xPos - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                value = math.floor(min + rel * (max - min))
                fill.Size = UDim2.new(rel, 0, 1, 0)
                lbl.Text = (config.Name or "Slider") .. ": " .. tostring(value)
                if config.Callback then config.Callback(value) end
            end
            dragBtn.MouseButton1Down:Connect(function() draggingSlider = true end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if draggingSlider and i.UserInputType == Enum.UserInputType.MouseMovement then
                    updateFromX(i.Position.X)
                end
            end)
            dragBtn.MouseButton1Click:Connect(function() end)
            return {Set = function(_, v) value = v; local rel=(v-min)/(max-min); fill.Size=UDim2.new(rel,0,1,0); lbl.Text=(config.Name or "Slider")..": "..tostring(v) end}
        end

        function SectionAPI:CreateDropdown(config)
            config = config or {}
            local options = config.Options or {}
            local current = config.CurrentOption or options[1] or ""
            local row = baseRow(30)
            local open = false

            local main = Instance.new("TextButton")
            main.Size = UDim2.new(1, 0, 0, 30)
            main.BackgroundColor3 = Theme.ToggleOff
            main.AutoButtonColor = false
            main.Font = FONT
            main.TextSize = TXT_SIZE
            main.TextColor3 = Theme.Text
            main.Text = (config.Name or "Select") .. ":  " .. tostring(current) .. "  ▾"
            main.Parent = row
            Instance.new("UICorner", main).CornerRadius = UDim.new(0, 4)

            local list = Instance.new("Frame")
            list.Size = UDim2.new(1, 0, 0, #options * 24)
            list.Position = UDim2.new(0, 0, 1, 4)
            list.BackgroundColor3 = Theme.Panel
            list.Visible = false
            list.ZIndex = 5
            list.Parent = main
            Instance.new("UICorner", list).CornerRadius = UDim.new(0, 4)
            local listLayout = Instance.new("UIListLayout", list)
            listLayout.SortOrder = Enum.SortOrder.LayoutOrder

            for _, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, 0, 0, 24)
                optBtn.BackgroundTransparency = 1
                optBtn.Font = FONT
                optBtn.TextSize = TXT_SIZE
                optBtn.TextColor3 = Theme.SubText
                optBtn.Text = "  " .. opt
                optBtn.TextXAlignment = Enum.TextXAlignment.Left
                optBtn.ZIndex = 6
                optBtn.Parent = list
                optBtn.MouseButton1Click:Connect(function()
                    current = opt
                    main.Text = (config.Name or "Select") .. ":  " .. tostring(current) .. "  ▾"
                    list.Visible = false
                    open = false
                    if config.Callback then config.Callback(opt) end
                end)
            end

            main.MouseButton1Click:Connect(function()
                open = not open
                list.Visible = open
            end)
            return {Set = function(_, v) current = v; main.Text = (config.Name or "Select")..":  "..tostring(v).."  ▾" end}
        end

        return SectionAPI
    end

    return TabAPI
end

