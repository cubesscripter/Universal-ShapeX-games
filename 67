-- Weapon spawn function
local function spawnWeapon(weaponName, ammoType, ammoAmount)
    local args = {
        ["TYPE"] = ITEM_TYPES:WaitForChild("FRAME_WEAPON_ITEM"),
        ["AMMO"] = ammoAmount or 4,
        ["COST"] = 9e-10,
        ["AMMO_TYPE"] = {
            ["TYPE"] = ITEM_TYPES:WaitForChild("FRAME_WEAPON_ITEM"),
            ["AMMO"] = ammoType or "Nails",
            ["COST"] = 2,
            ["WORTH"] = false,
            ["IMAGE_ID"] = "rbxassetid://14793880027",
            ["FORCE_PURCHASE"] = true,
            ["IMAGE_COLOR"] = Color3.new(1, 1, 1),
            ["ORDER"] = 10,
            ["WORTH_COST"] = 15,
            ["AMOUNT"] = 1
        },
        ["WORTH"] = true,
        ["IMAGE_ID"] = "rbxassetid://14673183012",
        ["FORCE_PURCHASE"] = true,
        ["IMAGE_COLOR"] = Color3.new(1, 1, 1),
        ["STAT"] = {},
        ["TOOL"] = ReplicatedStorage:WaitForChild("Weapons"):WaitForChild(weaponName),
        ["WORTH_COST"] = 35,
        ["ORDER"] = 2
    }
    
    local success, err = pcall(function()
        REMOTES:WaitForChild("REMOTE_ARSENAL"):FireServer(args)
    end)
    
    if success then
        Rayfield:Notify({
            Title = "Success",
            Content = weaponName .. " spawned!",
            Duration = 2,
            Image = "check"
        })
    else
        Rayfield:Notify({
            Title = "Error",
            Content = "Failed: " .. tostring(err),
            Duration = 3,
            Image = "x"
        })
    end
end

