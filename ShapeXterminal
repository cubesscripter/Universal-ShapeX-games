local function MakeTopButton(offsetFromRight, glyph, hoverColor)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(26, 22)
    b.AnchorPoint = Vector2.new(1, 0.5)
    b.Position = UDim2.new(1, -offsetFromRight, 0.5, 0)
    b.BackgroundTransparency = 1
    b.Text = glyph
    b.Font = FONT_BOLD
    b.TextSize = 15
    b.TextColor3 = Theme.SubText
    b.AutoButtonColor = false
    b.Parent = TitleBar
    b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {TextColor3 = hoverColor}):Play() end)
    b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {TextColor3 = Theme.SubText}):Play() end)
    return b
end

